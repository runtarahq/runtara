{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-5.6-sol",
  "small_model": "openai/gpt-5.6-luna-fast",
  "instructions": ["AGENTS.md"],
  "share": "disabled",
  "watcher": {
    "ignore": [
      "target/**",
      ".data/**",
      ".qemu-cache/**",
      "**/node_modules/**",
      "**/coverage/**",
      "**/dist/**",
      "**/__pycache__/**"
    ]
  },
  "tool_output": {
    "max_lines": 300,
    "max_bytes": 20000
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "tail_turns": 12
  },
  "mcp": {
    "runtara": {
      "enabled": false
    },
    "runtara_local": {
      "enabled": false
    }
  },
  "permission": {
    "read": {
      "*": "allow",
      ".env*": "ask",
      "**/.env*": "ask",
      ".env.example": "allow",
      "**/.env.example": "allow"
    },
    "bash": {
      "*": "allow",
      "git commit*": "ask",
      "git tag*": "ask",
      "git push*": "ask",
      "git reset --hard*": "ask",
      "git checkout --*": "ask",
      "git clean*": "ask",
      "kill *": "ask",
      "pkill *": "ask",
      "rm -rf *": "ask"
    }
  }
}
