// Canonical WIT contract for the workflow runtime/SDK component.
//
// The runtime component owns lifecycle and persistence-facing behavior:
// loading persisted input, completing/failing instances, event emission,
// cancellation, heartbeat, and durable sleep.

package runtara:workflow-runtime@0.4.0;

interface runtime {
    record signal-info {
        signal-type: string,
        command-id: string,
        payload: list<u8>,
        checkpoint-id: option<string>,
    }

    record custom-signal-info {
        signal-id: string,
        checkpoint-id: string,
        payload: list<u8>,
    }

    record checkpoint-result {
        found: bool,
        state: list<u8>,
        pending-signal: option<signal-info>,
        custom-signal: option<custom-signal-info>,
    }

    load-input: func() -> result<list<u8>, string>;

    instance-id: func() -> result<string, string>;

    complete: func(output: list<u8>) -> result<_, string>;

    fail: func(error: list<u8>) -> result<_, string>;

    custom-event: func(
        kind: string,
        payload: list<u8>,
    ) -> result<_, string>;

    debug-mode-enabled: func() -> result<bool, string>;

    breakpoint-pause: func() -> result<_, string>;

    heartbeat: func() -> result<_, string>;

    /// Read the pending lifecycle command without acknowledging it or publishing
    /// terminal/suspended status. Rate limiting may return none between polls.
    /// The guest retains an observed command while cleaning up active subtasks,
    /// then calls handle-checkpoint-signal with its type and command-id.
    /// Custom WaitForSignal payloads are not consumed by this operation.
    poll-signal: func() -> result<option<signal-info>, string>;

    /// Legacy consuming helper; do not use while subtasks still need cleanup.
    is-cancelled: func() -> result<bool, string>;

    check-signals: func() -> result<bool, string>;

    poll-custom-signal: func(
        checkpoint-id: string,
    ) -> result<option<list<u8>>, string>;

    /// Durable managed-input state, independent of debug telemetry.
    variant input-state {
        open,
        accepted(list<u8>),
        closed(string),
    }

    /// Register the immutable wait descriptor (JSON), with its original deadline.
    /// Tenant and invocation authority come from the host, never the descriptor.
    register-input: func(
        descriptor: list<u8>,
        deadline-ms: option<u64>,
    ) -> result<_, string>;

    /// Read accepted bytes or expire an unanswered wait using persistence time.
    poll-input: func(signal-id: string) -> result<input-state, string>;

    /// Abandon this wait without replacing a response that already won.
    close-input: func(signal-id: string) -> result<input-state, string>;

    now-ms: func() -> result<u64, string>;

    durable-sleep: func(ms: u64) -> result<_, string>;

    blocking-sleep: func(ms: u64) -> result<_, string>;

    get-checkpoint: func(
        checkpoint-id: string,
    ) -> result<option<list<u8>>, string>;

    checkpoint: func(
        checkpoint-id: string,
        state: list<u8>,
    ) -> result<checkpoint-result, string>;

    handle-checkpoint-signal: func(
        signal-type: string,
        command-id: string,
    ) -> result<bool, string>;

    record-retry-attempt: func(
        checkpoint-id: string,
        attempt-number: u32,
        error-message: option<string>,
    ) -> result<_, string>;

    durable-sleep-checkpoint: func(
        checkpoint-id: string,
        state: list<u8>,
        ms: u64,
    ) -> result<_, string>;
}

world workflow-runtime {
    export runtime;
}
