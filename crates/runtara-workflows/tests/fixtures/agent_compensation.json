{
  "name": "Agent Legacy Compensation",
  "description": "Back-compat fixture: an Agent step still carrying the removed compensation (saga) config, as saved before the field was removed. AgentStep is deny_unknown_fields, so this must keep parsing and lowering via the legacy_compensation tombstone; execution must match a plain return-input agent.",
  "durable": true,
  "steps": {
    "agent": {
      "stepType": "Agent",
      "id": "agent",
      "name": "Return Input",
      "agentId": "utils",
      "capabilityId": "return-input",
      "maxRetries": 0,
      "inputMapping": {
        "value": { "valueType": "reference", "value": "data.value" }
      },
      "compensation": {
        "compensationStep": "finish",
        "trigger": "on_downstream_error"
      }
    },
    "finish": {
      "stepType": "Finish",
      "id": "finish",
      "inputMapping": {
        "result": { "valueType": "reference", "value": "steps.agent.outputs" }
      }
    }
  },
  "entryPoint": "agent",
  "executionPlan": [
    { "fromStep": "agent", "toStep": "finish" }
  ],
  "variables": {},
  "inputSchema": {},
  "outputSchema": {}
}
