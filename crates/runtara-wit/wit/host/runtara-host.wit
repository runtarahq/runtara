// Compiler lowering vocabulary, not a host ABI.
//
// Workflow logic is emitted against these shapes, and the compiler serves
// them inside the artifact from `runtara:api` (the workflow API). No host
// links them: an artifact that imports one is refused as built for the
// removed host ABI. Tenant authority, credentials and network access stay in
// the host, behind the workflow API.
package runtara:host@1.0.0;

/// Safe connection metadata and connection-backed resources.
interface connections {
    // Return the safe, authoritative connection descriptor as JSON bytes.
    // Credentials and raw connection parameters are never included.
    describe: async func(connection-id: string) -> result<list<u8>, string>;

    // Resolve a typed, read-only resource request against the connection.
    // Both the request and the paginated response use the universal JSON
    // contracts from runtara-connections.
    resolve-resource: async func(
        connection-id: string,
        request: list<u8>,
    ) -> result<list<u8>, string>;
}

/// Host-satisfied concurrent timers for retry backoff and lifecycle polling.
interface timers {
    /// Async-typed so the emitter may async-lower it into a waitable; the
    /// world-level sync lowering is never called.
    sleep: async func(ms: u64);
    /// Emergency whole-execution alarm; dispose through standard cancellation.
    abort-after: async func(ms: u64);
}

world connections-client {
    import connections;
}

world timers-client {
    import timers;
}
