// Compiled workflow logic's interfaces.
//
// `tasks` is the one the host still serves (isolated and scoped children).
// `runtime`, `operation`, `waits` and `state` are compiler lowering
// vocabulary: workflow logic is emitted against them, and the compiler serves
// them inside the artifact from `runtara:api` (the workflow API). No host
// links them, and an artifact that imports one is refused as built for the
// removed host ABI. A workflow exports its entry as a
// `runtara:agent-<id>/capabilities` package (see `runtara:agent`).
package runtara:workflow@1.0.0;

// Run services: events, cancellation, heartbeat, checkpoints and durable
// sleep. A run finishes through its entry's return value, not a call here.
//
// Every function is `async` so that a guest component serving them (the
// workflow API's services adapter) may wait inside one; workflow logic still
// calls them with a synchronous lowering.
interface runtime {
    record signal-info {
        signal-type: string,
        command-id: string,
        payload: list<u8>,
        checkpoint-id: option<string>,
    }

    record custom-signal-info {
        signal-id: string,
        checkpoint-id: string,
        payload: list<u8>,
    }

    record checkpoint-result {
        found: bool,
        state: list<u8>,
        pending-signal: option<signal-info>,
        custom-signal: option<custom-signal-info>,
    }

    instance-id: async func() -> result<string, string>;

    custom-event: async func(
        kind: string,
        payload: list<u8>,
    ) -> result<_, string>;

    debug-mode-enabled: async func() -> result<bool, string>;

    breakpoint-pause: async func() -> result<_, string>;

    heartbeat: async func() -> result<_, string>;

    /// Read the pending lifecycle command without acknowledging it or publishing
    /// terminal/suspended status. Rate limiting may return none between polls.
    /// The guest retains an observed command while cleaning up active subtasks,
    /// then calls handle-checkpoint-signal with its type and command-id.
    /// Custom WaitForSignal payloads are not consumed by this operation.
    poll-signal: async func() -> result<option<signal-info>, string>;

    /// Legacy consuming helper; do not use while subtasks still need cleanup.
    is-cancelled: async func() -> result<bool, string>;

    check-signals: async func() -> result<bool, string>;

    poll-custom-signal: async func(
        checkpoint-id: string,
    ) -> result<option<list<u8>>, string>;

    /// Durable managed-input state, independent of debug telemetry.
    variant input-state {
        open,
        accepted(list<u8>),
        closed(string),
    }

    /// Register the immutable wait descriptor (JSON), with its original deadline.
    /// Tenant and invocation authority come from the host, never the descriptor.
    register-input: async func(
        descriptor: list<u8>,
        deadline-ms: option<u64>,
    ) -> result<_, string>;

    /// Read accepted bytes or expire an unanswered wait using persistence time.
    poll-input: async func(signal-id: string) -> result<input-state, string>;

    /// Abandon this wait without replacing a response that already won.
    close-input: async func(signal-id: string) -> result<input-state, string>;

    now-ms: async func() -> result<u64, string>;

    durable-sleep: async func(ms: u64) -> result<_, string>;

    blocking-sleep: async func(ms: u64) -> result<_, string>;

    /// Read a result checkpoint without writing anything.
    get-checkpoint: async func(
        checkpoint-id: string,
    ) -> result<option<list<u8>>, string>;

    /// Record a result checkpoint: the first committed state for the id wins,
    /// and a later call gets that state back as `found`. Empty `state` is
    /// accepted only for compatibility, as a read probe; use `get-checkpoint`
    /// to read.
    checkpoint: async func(
        checkpoint-id: string,
        state: list<u8>,
    ) -> result<checkpoint-result, string>;

    handle-checkpoint-signal: async func(
        signal-type: string,
        command-id: string,
    ) -> result<bool, string>;

    record-retry-attempt: async func(
        checkpoint-id: string,
        attempt-number: u32,
        error-message: option<string>,
    ) -> result<_, string>;

    durable-sleep-checkpoint: async func(
        checkpoint-id: string,
        state: list<u8>,
        ms: u64,
    ) -> result<_, string>;
}

// Generic owned child executions. Private runtime ABI, not part of the DSL:
// no compilation, graph traversal, retry or recovery policy in the host.
interface tasks {
    use runtara:agent/types@1.0.0.{error-info, wake};

    resource task;

    variant entry {
        capability(string),
        workflow,
    }

    // Generated by the parent. The launch adapter validates this relative to
    // its immutable root/tenant/parent scope; it is not an authorization token.
    record invocation-context {
        path: string,
        attempt: u64,
    }

    enum execution-error {
        unavailable,
        closed,
        capacity,
        invalid-binding,
        invalid-context,
        invalid-task,
        worker-lost,
    }

    enum cancel-status {
        requested,
        already-requested,
        already-terminal,
    }

    variant task-outcome {
        completed(list<u8>),
        failed(error-info),
        suspended(list<wake>),
        cancelled,
        timed-out,
        trapped(string),
    }

    // No compilation, graph traversal, retry or recovery policy in the host.
    start: func(binding: string, entry: entry, input: list<u8>, context: invocation-context)
        -> result<task, execution-error>;
    request-cancel: func(handle: borrow<task>) -> result<cancel-status, execution-error>;
    // A terminal result is published only after execution has been destroyed.
    join: async func(handle: borrow<task>) -> result<task-outcome, execution-error>;
    // Idempotent while the resource remains owned. Cancels/reaps live work.
    release: async func(handle: borrow<task>) -> result<_, execution-error>;
}

// Compiler-emitted operation scope around an operation-scoped call site (a
// suspending capability or a control mutation). The host keys everything by
// `op-hash = sha256(checkpoint-key)` together with the caller instance it
// owns, where `checkpoint-key` is the canonical v2 Agent checkpoint key of
// the call site. Identity never comes from agent input.
interface operation {
    use runtara:agent/types@1.0.0.{wake};

    /// Enter the operation of this call site. With `load`, the continuation
    /// saved for `attempt` becomes the operation's context, which the host
    /// hands to the capability (`runtara:agent/continuation`, or the
    /// control executor's `continuation` argument).
    enter: func(checkpoint-key: string, attempt: u32, load: bool) -> result<_, string>;

    /// Persist `state` as the entered operation's continuation, attach its
    /// instance waits, and leave the operation. The caller then parks until
    /// any wake fires or the step deadline passes. Rejects a suspension that
    /// breaks the caps (no wakes, more than 16, a wait id over 64 bytes, a
    /// state over 64 KiB).
    suspend: func(state: list<u8>, wakes: list<wake>) -> result<_, string>;

    /// Leave the operation after the capability completed (`failed` false) or
    /// failed. A failure discards the continuation, so a replay starts the
    /// operation afresh.
    exit: func(failed: bool);

    /// Drop everything kept for the operation once its result is
    /// checkpointed. Idempotent.
    release: func(checkpoint-key: string);
}
